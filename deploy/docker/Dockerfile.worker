# deploy/docker/Dockerfile.worker
FROM golang:1.24-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /clm-worker ./cmd/worker

FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /clm-worker /app/clm-worker

ENTRYPOINT ["/app/clm-worker"]
