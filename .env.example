# .env.example
# Certificate Lifecycle Management (CLM) Configuration

# Database
# Use postgres in production; sqlite in local development
CLM_DATABASE_URL=postgres://clm_app_role:secret_password@localhost:5432/clm?sslmode=disable

# Control Plane API
CLM_LISTEN_ADDR=:8080
PORT=8080
CLM_PUBLIC_URL=http://localhost:8080
CLM_LOG_LEVEL=info
CLM_LOG_FORMAT=json

# Identity & OIDC
CLM_OIDC_ISSUER=https://sso.example.com/realms/clm
CLM_OIDC_CLIENT_ID=clm-web
CLM_JWT_ALLOWED_ALGS=RS256,ES256

# Satellite Gateway Configuration
CLM_GATEWAY_CONTROL_PLANE_URL=http://localhost:8080
CLM_GATEWAY_KEYSTORE_TYPE=software
CLM_GATEWAY_POLICY_GRACE=72h
CLM_GATEWAY_MAX_CLOCK_SKEW=30s

# Audit & Evidence
CLM_AUDIT_OBJECT_STORE=s3://clm-audit-worm
CLM_AUDIT_ANCHOR_TSA=https://tsa.example.com
